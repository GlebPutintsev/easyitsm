# Вход для разработки: заголовки X-Dev-*, сервер принимает их только в профиле dev.
VITE_DEV_USER=01930000-0000-7000-8000-0000000000aa
VITE_DEV_TENANT=01930000-0000-7000-8000-000000000001
VITE_DEV_ROLES=AGT,ADM
# Источник данных рабочего места агента: mock (по умолчанию, пока нет API модуля tickets) или http.
VITE_TICKETS_API=mock
