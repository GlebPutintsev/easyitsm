# Служба агента обнаружения Easy ITSM.
#   install -m 755 discovery-agent /usr/local/bin/
#   install -d -m 750 /etc/easyitsm && install -m 640 discovery.example.json /etc/easyitsm/discovery.json
#   install -m 600 /dev/null /etc/easyitsm/discovery.token   # и вставить токен источника
#   install -m 644 easyitsm-discovery.service /etc/systemd/system/ && systemctl enable --now easyitsm-discovery
#
# Агент работает от root только ради серийного номера и UUID платформы (/sys/class/dmi/id доступен root).
# Без них ВМ и серверы опознаются по FQDN: тогда раскомментируйте DynamicUser и уберите права на запись.
[Unit]
Description=Easy ITSM discovery agent
Documentation=https://github.com/GlebPutintsev/easyitsm/tree/main/discovery-agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/discovery-agent -config /etc/easyitsm/discovery.json run
Restart=on-failure
RestartSec=30s
# DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/etc/easyitsm

[Install]
WantedBy=multi-user.target
